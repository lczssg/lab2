module wic2005-intent {
  yang-version 1.1;
  namespace "urn:wic2005:intent";
  prefix wi;

  import ietf-inet-types {
    prefix inet;
  }

  description
    "Desired VLANs and ordered ACL rules for the campus media lab.";

  revision 2026-11-28 {
    description
      "Add an optional ACL logging preference.";
  }

  revision 2026-11-27 {
    description
      "Model the Week 7 intent and its configuration constraints.";
  }

  typedef campus-prefix {
    type inet:ipv4-prefix {
      pattern '10\.1\.[0-9]{1,3}\.[0-9]{1,3}/(1[6-9]|2[0-9]|3[0-2])' {
        error-message "Use an explicit IPv4 prefix inside 10.1.0.0/16.";
      }
    }
    description
      "An IPv4 prefix inside the campus media lab allocation.";
  }

  container intent {
    must "acl[action = 'permit']" {
      error-message "At least one ACL entry must permit traffic.";
    }
    must "acl[action = 'deny']" {
      error-message "At least one ACL entry must deny traffic.";
    }
    must "acl[port]" {
      error-message "At least one ACL entry must specify a port.";
    }

    leaf student_id_last4 {
      type string {
        pattern '[0-9]{4}';
      }
      mandatory true;
    }

    list vlans {
      key "id";
      min-elements 6;

      leaf id {
        type uint16 {
          range "11..4094";
        }
      }
      leaf name {
        type string {
          length "1..32";
          pattern '[A-Za-z0-9_-]*';
        }
        mandatory true;
      }
    }

    list acl {
      key "description";
      min-elements 4;
      ordered-by user;

      leaf description {
        type string;
        description
          "Required unique rule description, used as the list key.";
      }
      leaf action {
        type enumeration {
          enum permit;
          enum deny;
        }
        mandatory true;
      }
      leaf src {
        type campus-prefix;
        mandatory true;
      }
      leaf dst {
        type campus-prefix;
        mandatory true;
      }
      leaf protocol {
        type enumeration {
          enum tcp;
          enum udp;
          enum icmp;
          enum any;
        }
        default "any";
      }
      leaf port {
        when "../protocol = 'tcp' or ../protocol = 'udp'";
        type inet:port-number {
          range "1..65535";
        }
      }
    }
  }
}
